R_TOOLS_VERSION := $(shell Rscript -e 'grep("RTOOLS.*HOME", names(Sys.getenv()), value = TRUE)')
R_TOOLS_SOFT := $(shell Rscript -e 'cat(normalizePath(Sys.getenv($(R_TOOLS_VERSION))), winslash = "/")')

PKG_CFLAGS += $(SHLIB_OPENMP_CFLAGS) -I$(R_TOOLS_SOFT)/include
PKG_LIBS += $(SHLIB_OPENMP_CFLAGS) -lpthread -lpsapi -lbcrypt

MIMALLOC_LIB := $(firstword $(wildcard $(R_TOOLS_SOFT)/lib/libmimalloc.a))
PACMAN := $(R_TOOLS_SOFT)/../usr/bin/pacman.exe

ifeq ($(strip $(MIMALLOC_LIB)),)
$(info libmimalloc.a not found under $(R_TOOLS_SOFT)/lib; attempting pacman install)
ifeq ($(wildcard $(PACMAN)),)
$(error pacman not found at $(PACMAN); check R_TOOLS_SOFT)
endif
$(shell "$(PACMAN)" -S --noconfirm --needed mingw-w64-ucrt-x86_64-mimalloc >/dev/null 2>&1)
MIMALLOC_LIB := $(firstword $(wildcard $(R_TOOLS_SOFT)/lib/libmimalloc.a))
endif

ifeq ($(strip $(MIMALLOC_LIB)),)
$(error libmimalloc.a still missing under $(R_TOOLS_SOFT)/lib after pacman install attempt)
endif

PKG_LIBS += -L$(dir $(MIMALLOC_LIB)) -lmimalloc
